---
// src/pages/index.astro - Main Marketing Homepage for GPS Muscat
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PromotionsCarousel from '../components/PromotionsCarousel.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import BrandMarquee from '../components/BrandMarquee.astro';
import ProductCatalog from '../components/ProductCatalog.astro';
import ApplicationsSection from '../components/ApplicationsSection.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "GPS Muscat | Gate Automation, Boom Barriers & Access Control in Oman";
const pageDescription = "Official technical supplier of Italian sliding and swing gate motors, automatic boom barriers, access control, and security hardware in Muscat, Oman. Branches in Al Khoudh & Ghala.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Header />

  <main class="flex-1">
    <!-- 1. Home / Hero Equipment Showcase -->
    <Hero />

    <!-- 2. Active Offers / 9:16 Story Promotions Carousel (Placed directly after Home) -->
    <PromotionsCarousel />

    <!-- 3. About Us / Authority & Muscat Warehouses -->
    <WhyChooseUs />

    <!-- 4. Authorized Partner Brands Ribbon -->
    <BrandMarquee />

    <!-- 5. 6-Category Technical Equipment Catalog -->
    <ProductCatalog />

    <!-- 6. Application Scenarios (Residential, Commercial, Industrial) -->
    <ApplicationsSection />
  </main>

  <!-- 7. Contact Us / Branch Locations & Direct Triggers -->
  <Footer />
</BaseLayout>
