---
// src/pages/index.astro - Main Marketing Homepage for GPS Muscat
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import PromotionsCarousel from '../components/PromotionsCarousel.astro';
import WhyChooseUs from '../components/WhyChooseUs.astro';
import BrandMarquee from '../components/BrandMarquee.astro';
import ProductCatalog from '../components/ProductCatalog.astro';
import ApplicationsSection from '../components/ApplicationsSection.astro';
import Footer from '../components/Footer.astro';

const pageTitle = "GPS Muscat | Automatic Gate Motors, Boom Barriers & Access Control Oman";
const pageDescription = "Premier technical supplier of automatic sliding & swing gate motors, vehicle boom barriers, biometric access control, EM locks & glass door systems in Muscat, Oman. Official Italian & European brands in Al Khoudh & Ghala.";
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Header />

  <main class="flex-1">
    <!-- 1. Home / Hero Equipment Showcase -->
    <Hero />

    <!-- 2. Active Offers / 9:16 Story Promotions Carousel (Placed directly after Home) -->
    <PromotionsCarousel />

    <!-- 3. About Us / Authority & Muscat Warehouses -->
    <WhyChooseUs />

    <!-- 4. Authorized Partner Brands Ribbon -->
    <BrandMarquee />

    <!-- 5. 6-Category Technical Equipment Catalog -->
    <ProductCatalog />

    <!-- 6. Application Scenarios (Residential, Commercial, Industrial) -->
    <ApplicationsSection />
  </main>

  <!-- 7. Contact Us / Branch Locations & Direct Triggers -->
  <Footer />
</BaseLayout>
