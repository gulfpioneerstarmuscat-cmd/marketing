---
// src/components/ApplicationsSection.astro - Practical Use-Case Scenarios
import { applicationScenarios } from '../data/applications';
---

<section id="applications" class="py-16 sm:py-24 border-t border-slate-200/80 dark:border-slate-800/80 bg-slate-100/30 dark:bg-slate-900/20 transition-colors">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-xs font-semibold text-cyan-600 dark:text-cyan-400 mb-3">
        <span>Tailored Installations Across Muscat</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        Engineered for Every <span class="bg-linear-to-r from-sky-600 via-cyan-500 to-blue-600 dark:from-cyan-400 dark:via-sky-300 dark:to-blue-500 bg-clip-text text-transparent">Project Scale</span>
      </h2>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 mt-2.5 leading-relaxed">
        From private luxury villas in Al Mouj to heavy industrial freight yards in Ghala and Rusayl, we supply proven hardware matched precisely to duty cycles.
      </p>
    </div>

    <!-- 3-Column Scenario Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 items-stretch">
      {applicationScenarios.map((scenario) => (
        <div
          class="flex flex-col justify-between rounded-2xl glass-card border border-slate-200/80 dark:border-slate-800/80 p-6 sm:p-7 hover:border-cyan-500/40 transition-all duration-300 hover:shadow-xl hover:shadow-cyan-500/5 group"
        >
          <div class="space-y-4">
            <!-- Scenario Badge & Icon -->
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-semibold px-2.5 py-1 rounded-full bg-cyan-500/10 text-cyan-700 dark:text-cyan-400 border border-cyan-500/20">
                {scenario.tag}
              </span>
              <span class="w-9 h-9 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 flex items-center justify-center font-bold text-sm">
                {scenario.tag === 'Residential' ? '🏡' : scenario.tag === 'Commercial' ? '🏢' : '🏭'}
              </span>
            </div>

            <!-- Title & Subtitle -->
            <div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">
                {scenario.title}
              </h3>
              <p class="text-xs font-medium text-cyan-600 dark:text-cyan-400 mt-0.5">
                {scenario.subtitle}
              </p>
            </div>

            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
              {scenario.description}
            </p>

            <!-- Recommended Equipment Pill Group -->
            <div class="pt-2">
              <span class="text-[10px] font-mono uppercase tracking-wider text-slate-400 block mb-2">
                Recommended Hardware Kits:
              </span>
              <div class="flex flex-wrap gap-1.5">
                {scenario.recommendedGear.map((gear) => (
                  <span class="text-[11px] font-medium px-2 py-0.5 rounded-md bg-slate-100/90 dark:bg-slate-800/80 border border-slate-200/60 dark:border-slate-700/60 text-slate-700 dark:text-slate-300">
                    {gear}
                  </span>
                ))}
              </div>
            </div>

            <!-- Ideal Application Bullets -->
            <div class="pt-2 space-y-1 text-xs text-slate-600 dark:text-slate-300">
              <span class="text-[10px] font-mono uppercase tracking-wider text-slate-400 block mb-1">
                Typical Deployments:
              </span>
              {scenario.idealFor.map((item) => (
                <div class="flex items-center gap-2 text-[11px]">
                  <span class="text-cyan-500 font-bold">•</span>
                  <span>{item}</span>
                </div>
              ))}
            </div>

          </div>

          <!-- Bottom Branch Trigger Link -->
          <div class="pt-6 mt-6 border-t border-slate-200/80 dark:border-slate-800/80">
            <a
              href="#contact"
              class="inline-flex items-center gap-1.5 text-xs font-bold text-cyan-700 dark:text-cyan-400 hover:text-cyan-600 dark:hover:text-cyan-300 transition-colors"
            >
              <span>Get Sizing Advice for this Scenario</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>
          </div>

        </div>
      ))}
    </div>

  </div>

</section>
