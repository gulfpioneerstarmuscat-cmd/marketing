---
// src/components/Hero.astro - High-Impact Entrance & Automation Showcase

// Single Source of Truth for the Hero Spec Visualizer Tabs
const heroTabs = {
  sliding: {
    category: "Heavy-Duty Sliding Operators",
    capacity: "400kg – 2,000kg",
    title: "Industrial & Villa Motor Kits",
    desc: "Highly Efficent top of the line Sliding Gate Motors. Complete kits including nylon or steel rack, dual photocell pair, flashing beacon, and 2 rolling-code remotes.",
    stat1: { label: "Duty Rating", val: "Intensive Cycle" },
    stat2: { label: "Climate Rating", val: "-20°C to +65°C" },
    stat3: { label: "Gearbox Type", val: "Bronze / Oil Bath" },
    stat4: { label: "Supported Brands", val: "Beninca, BFT, CAME" },
    link: "#gate-automation",
    btnText: "View Gate Automation Specifications"
  },
  barriers: {
    category: "Automatic Boom Barriers",
    capacity: "Up to 6-Meter Arms",
    title: "High-Speed Commercial & Compound Barriers",
    desc: "Fast-acting 1.5s to 4s automatic traffic barrier cabinets. Includes straight, 90° articulated folding for underground basements, and LED arm warning strips.",
    stat1: { label: "Opening Speed", val: "1.5s - 4.0s Fast" },
    stat2: { label: "Duty Rating", val: "100% Continuous" },
    stat3: { label: "Safety Profile", val: "Loop + Pressure Edge" },
    stat4: { label: "Supported Brands", val: "BFT, Roger, DEA, CAME" },
    link: "#boom-barriers",
    btnText: "View Barrier Specifications"
  },
  access: {
    category: "Integrated Access Control",
    capacity: "10,000 User Capacity",
    title: "Biometric Scanners, RFID & EM Locks",
    desc: "Waterproof IP68 metal standalone PIN & card readers, long-range windshield UHF tags, and 280kg/500kg magnetic locks with fail-safe power supply backup.",
    stat1: { label: "Ingress Rating", val: "IP68 Weatherproof" },
    stat2: { label: "Holding Force", val: "280kg / 500kg Locks" },
    stat3: { label: "Auth Modes", val: "Fingerprint, Card, PIN" },
    stat4: { label: "Supported Brands", val: "Hikvision, Standalone" },
    link: "#access-control",
    btnText: "View Access Control Specifications"
  }
};

const initialTab = heroTabs.sliding;
---

<section class="relative pt-10 pb-16 sm:pt-16 sm:pb-24 lg:pt-20 lg:pb-32 overflow-hidden transition-colors">
  
  <!-- Subtle Ambient Glow Effects -->
  <div class="absolute top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[450px] overflow-hidden pointer-events-none -z-10">
    <div class="absolute -top-32 left-1/4 w-[30rem] h-[30rem] bg-cyan-500/15 dark:bg-cyan-500/10 rounded-full blur-[140px]"></div>
    <div class="absolute -top-20 right-1/4 w-[28rem] h-[28rem] bg-blue-500/10 dark:bg-sky-600/10 rounded-full blur-[130px]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Hero Grid: Left Content, Right Interactive Visualizer -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Column: Copy, Value Badges & Actions -->
      <div class="lg:col-span-7 space-y-6 sm:space-y-7 text-left">
        
        <!-- Eyebrow Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-xs font-semibold text-cyan-600 dark:text-cyan-400">
          <span class="w-2 h-2 rounded-full bg-cyan-500 dark:bg-cyan-400 animate-pulse"></span>
          <span>Gulf Pioneer Star Muscat • Official Equipment Supplier</span>
        </div>

        <!-- Primary Headline -->
        <h1 class="text-4xl sm:text-5xl lg:text-[3.5rem] font-extrabold tracking-tight text-slate-900 dark:text-white leading-[1.12]">
          Commercial & Residential <br class="hidden sm:inline" />
          <span class="bg-gradient-to-r from-sky-600 via-cyan-500 to-blue-600 dark:from-cyan-400 dark:via-sky-300 dark:to-blue-500 bg-clip-text text-transparent">
            Gate Automation
          </span> & <br class="hidden sm:inline" />
          Access Control Systems.
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-slate-600 dark:text-slate-300 max-w-2xl leading-relaxed">
          Muscat's premier technical supplier of Italian sliding and swing gate motors, high-cycle parking boom barriers, electromagnetic locks, and biometric entrance hardware. Ready stock with same-day pickup at our Al Khoudh & Ghala branches.
        </p>

        <!-- CTAs (All routing smoothly to site sections, no hardcoded phone numbers) -->
        <div class="pt-2 flex flex-wrap items-center gap-3.5 sm:gap-4">
          <!-- Primary: Products Grid -->
          <a
            href="#products"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-slate-900 hover:bg-slate-800 dark:bg-gradient-to-r dark:from-sky-500 dark:via-cyan-500 dark:to-blue-600 dark:hover:from-sky-400 dark:hover:to-cyan-400 text-white dark:text-slate-950 font-bold text-sm shadow-xl shadow-cyan-500/10 hover:shadow-cyan-500/25 transition-all duration-200 hover:-translate-y-0.5 active:scale-95"
          >
            <span>Explore Equipment Catalog</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
            </svg>
          </a>

          <!-- Secondary: Active Promotions -->
          <a
            href="#promotions"
            class="inline-flex items-center gap-2 px-5 py-3.5 rounded-xl bg-white/80 dark:bg-slate-900/80 hover:bg-white dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 border border-slate-200/90 dark:border-slate-800 font-semibold text-sm transition-all duration-200 hover:-translate-y-0.5 active:scale-95 shadow-sm"
          >
            <span class="w-2 h-2 rounded-full bg-cyan-500"></span>
            <span>View Active Offers</span>
          </a>

          <!-- Tertiary: Branch Locations -->
          <a
            href="#contact"
            class="inline-flex items-center gap-1.5 text-xs font-semibold text-slate-500 dark:text-slate-400 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors py-2 px-2"
          >
            <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
            </svg>
            <span>Al Khoudh & Ghala Branches</span>
          </a>
        </div>

        <!-- Trust Features Row -->
        <div class="pt-4 border-t border-slate-200/80 dark:border-slate-800/80 grid grid-cols-2 sm:grid-cols-3 gap-3.5 text-xs text-slate-600 dark:text-slate-300">
          <div class="flex items-center gap-2">
            <span class="w-5 h-5 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-xs">✓</span>
            <span>Italian & European Motors</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-5 h-5 rounded-md bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 flex items-center justify-center font-bold text-xs">✓</span>
            <span>Muscat Ready Stock</span>
          </div>
          <div class="flex items-center gap-2 col-span-2 sm:col-span-1">
            <span class="w-5 h-5 rounded-md bg-sky-500/10 text-sky-600 dark:text-sky-400 flex items-center justify-center font-bold text-xs">✓</span>
            <span>Same-Day Branch Pickup</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Interactive Equipment Visualizer -->
      <div class="lg:col-span-5">
        <div class="glass-card rounded-2xl p-6 sm:p-7 space-y-6 relative overflow-hidden border border-slate-200/80 dark:border-slate-800/80 shadow-2xl">
          
          <!-- Ambient Corner Glow -->
          <div class="absolute -top-14 -right-14 w-44 h-44 bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>

          <!-- Top Terminal Header -->
          <div class="flex items-center justify-between pb-4 border-b border-slate-200/80 dark:border-slate-800/80">
            <div class="flex items-center gap-2.5">
              <span class="w-2.5 h-2.5 rounded-full bg-rose-500"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-amber-500"></span>
              <span class="w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
              <span class="text-[11px] font-mono text-slate-500 dark:text-slate-400 ml-2">SPEC: GPS_OMAN_EQUIP</span>
            </div>
            <span class="text-[10px] font-mono px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 font-semibold">
              Live Stock
            </span>
          </div>

          <!-- Interactive Tab Selector -->
          <div class="grid grid-cols-3 gap-1.5 p-1 rounded-xl bg-slate-100 dark:bg-slate-900/90 border border-slate-200 dark:border-slate-800 text-[11px] font-semibold text-center">
            <button
              type="button"
              id="hero-tab-sliding"
              class="hero-tab-btn py-1.5 px-2 rounded-lg transition-all bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm"
              data-tab="sliding"
            >
              Sliding Gates
            </button>
            <button
              type="button"
              id="hero-tab-barriers"
              class="hero-tab-btn py-1.5 px-2 rounded-lg transition-all text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white"
              data-tab="barriers"
            >
              Boom Barriers
            </button>
            <button
              type="button"
              id="hero-tab-access"
              class="hero-tab-btn py-1.5 px-2 rounded-lg transition-all text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white"
              data-tab="access"
            >
              Access Control
            </button>
          </div>

          <!-- Dynamic Specification Card View (Rendered directly from Single Source of Truth) -->
          <div id="hero-spec-content" class="space-y-4">
            <div class="space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-xs font-mono text-cyan-600 dark:text-cyan-400 uppercase tracking-wider">{initialTab.category}</span>
                <span class="text-xs font-bold text-slate-900 dark:text-white">{initialTab.capacity}</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white">{initialTab.title}</h3>
              <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
                {initialTab.desc}
              </p>
            </div>

            <!-- Metric Badges Grid -->
            <div class="grid grid-cols-2 gap-3 pt-2">
              <div class="p-3 rounded-xl bg-slate-100/80 dark:bg-slate-900/80 border border-slate-200/80 dark:border-slate-800">
                <span class="text-[10px] font-mono text-slate-400 uppercase block">{initialTab.stat1.label}</span>
                <span class="text-xs font-bold text-slate-900 dark:text-white mt-0.5 block">{initialTab.stat1.val}</span>
              </div>
              <div class="p-3 rounded-xl bg-slate-100/80 dark:bg-slate-900/80 border border-slate-200/80 dark:border-slate-800">
                <span class="text-[10px] font-mono text-slate-400 uppercase block">{initialTab.stat2.label}</span>
                <span class="text-xs font-bold text-slate-900 dark:text-white mt-0.5 block">{initialTab.stat2.val}</span>
              </div>
              <div class="p-3 rounded-xl bg-slate-100/80 dark:bg-slate-900/80 border border-slate-200/80 dark:border-slate-800">
                <span class="text-[10px] font-mono text-slate-400 uppercase block">{initialTab.stat3.label}</span>
                <span class="text-xs font-bold text-slate-900 dark:text-white mt-0.5 block">{initialTab.stat3.val}</span>
              </div>
              <div class="p-3 rounded-xl bg-slate-100/80 dark:bg-slate-900/80 border border-slate-200/80 dark:border-slate-800">
                <span class="text-[10px] font-mono text-slate-400 uppercase block">{initialTab.stat4.label}</span>
                <span class="text-xs font-bold text-cyan-600 dark:text-cyan-400 mt-0.5 block">{initialTab.stat4.val}</span>
              </div>
            </div>

            <!-- Inquire Button Routing to Branch Selector -->
            <a
              href={initialTab.link}
              class="w-full inline-flex items-center justify-center gap-2 py-3 rounded-xl bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-700 dark:text-cyan-400 font-bold text-xs border border-cyan-500/30 transition-all"
            >
              <span>{initialTab.btnText}</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
              </svg>
            </a>
          </div>

          <!-- Bottom Status Ticker -->
          <div class="pt-3 border-t border-slate-200/80 dark:border-slate-800/80 flex items-center justify-between text-[11px] text-slate-500 dark:text-slate-400">
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
              Al Khoudh Branch: Open 09:00 - 17:00
            </span>
            <span class="font-mono">Ghala: Open 08:00 - 16:00</span>
          </div>

        </div>
      </div>

    </div>

  </div>

</section>

<script is:inline define:vars={{ heroTabs }}>
  // Interactive Hero Equipment Tab Switcher (Uses heroTabs from server frontmatter)
  (function() {
    const container = document.getElementById('hero-spec-content');
    const tabBtns = document.querySelectorAll('.hero-tab-btn');

    tabBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const tabKey = btn.getAttribute('data-tab');
        const data = heroTabs[tabKey];
        if (!data || !container) return;

        // Update active tab button style
        tabBtns.forEach(b => {
          b.className = "hero-tab-btn py-1.5 px-2 rounded-lg transition-all text-slate-500 dark:text-slate-400 hover:text-slate-900 dark:hover:text-white";
        });
        btn.className = "hero-tab-btn py-1.5 px-2 rounded-lg transition-all bg-white dark:bg-slate-800 text-slate-900 dark:text-white shadow-sm font-semibold";

        // Render tab content
        container.innerHTML = `
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono text-cyan-600 dark:text-cyan-400 uppercase tracking-wider">${data.category}</span>
              <span class="text-xs font-bold text-slate-900 dark:text-white">${data.capacity}</span>
            </div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white">${data.title}</h3>
            <p class="text-xs text-slate-500 dark:text-slate-400 leading-relaxed">
              ${data.desc}
            </p>
          </div>

          <div class="grid grid-cols-2 gap-3 pt-2">
            <div class="p-3 rounded-xl bg-slate-100/80 dark:bg-slate-900/80 border border-slate-200/80 dark:border-slate-800">
              <span class="text-[10px] font-mono text-slate-400 uppercase block">${data.stat1.label}</span>
              <span class="text-xs font-bold text-slate-900 dark:text-white mt-0.5 block">${data.stat1.val}</span>
            </div>
            <div class="p-3 rounded-xl bg-slate-100/80 dark:bg-slate-900/80 border border-slate-200/80 dark:border-slate-800">
              <span class="text-[10px] font-mono text-slate-400 uppercase block">${data.stat2.label}</span>
              <span class="text-xs font-bold text-slate-900 dark:text-white mt-0.5 block">${data.stat2.val}</span>
            </div>
            <div class="p-3 rounded-xl bg-slate-100/80 dark:bg-slate-900/80 border border-slate-200/80 dark:border-slate-800">
              <span class="text-[10px] font-mono text-slate-400 uppercase block">${data.stat3.label}</span>
              <span class="text-xs font-bold text-slate-900 dark:text-white mt-0.5 block">${data.stat3.val}</span>
            </div>
            <div class="p-3 rounded-xl bg-slate-100/80 dark:bg-slate-900/80 border border-slate-200/80 dark:border-slate-800">
              <span class="text-[10px] font-mono text-slate-400 uppercase block">${data.stat4.label}</span>
              <span class="text-xs font-bold text-cyan-600 dark:text-cyan-400 mt-0.5 block">${data.stat4.val}</span>
            </div>
          </div>

          <a
            href="${data.link}"
            class="w-full inline-flex items-center justify-center gap-2 py-3 rounded-xl bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-700 dark:text-cyan-400 font-bold text-xs border border-cyan-500/30 transition-all"
          >
            <span>${data.btnText}</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
        `;
      });
    });
  })();
</script>
