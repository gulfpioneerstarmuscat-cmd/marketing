    function showAlert(msg, type = 'error') {
      if (!alertBox) return;
      alertBox.classList.remove('hidden', 'bg-rose-500/10', 'text-rose-600', 'border-rose-500/20', 'bg-emerald-500/10', 'text-emerald-600', 'border-emerald-500/20');
      if (type === 'error') {
        alertBox.classList.add('bg-rose-500/10', 'text-rose-600', 'dark:text-rose-400', 'border', 'border-rose-500/20');
      } else {
        alertBox.classList.add('bg-emerald-500/10', 'text-emerald-600', 'dark:text-emerald-400', 'border', 'border-emerald-500/20');
      }
      alertBox.textContent = msg;
      alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function clearAlert() {
      if (!alertBox) return;
      alertBox.classList.add('hidden');
      alertBox.textContent = '';
    }
  })();
</script>

