---
// src/components/QuoteModal.astro - Modern Interactive Quotation Modal for GPS Muscat
// Supports Web3Forms email delivery + 1-Click pre-formatted WhatsApp quote to Al Khoudh or Ghala branch.

// Default placeholder Web3Forms access key (can be set via environment variable or Web3Forms dashboard)
const web3FormsKey = import.meta.env.PUBLIC_WEB3FORMS_KEY || "YOUR_ACCESS_KEY_HERE";
---

<!-- Modal Root Overlay -->
<div
  id="quote-modal"
  class="fixed inset-0 z-50 hidden items-center justify-center p-3 sm:p-4 md:p-6 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-labelledby="quote-modal-title"
>
  <!-- Backdrop Blur Overlay -->
  <div
    id="quote-modal-backdrop"
    class="fixed inset-0 bg-slate-950/75 backdrop-blur-md transition-opacity duration-300"
    aria-hidden="true"
  ></div>

  <!-- Modal Dialog Container -->
  <div
    id="quote-modal-content"
    class="relative w-full max-w-2xl bg-white dark:bg-slate-900 border border-slate-200/90 dark:border-slate-800 rounded-2xl sm:rounded-3xl shadow-2xl shadow-cyan-950/20 dark:shadow-cyan-500/5 overflow-hidden z-10 transition-all duration-300 transform scale-95 opacity-0 my-auto"
  >
    <!-- Modal Ambient Glow Top -->
    <div class="absolute -top-24 left-1/2 -translate-x-1/2 w-96 h-32 bg-cyan-500/15 dark:bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

    <!-- Modal Header -->
    <div class="relative px-5 sm:px-8 pt-6 pb-4 border-b border-slate-100 dark:border-slate-800/80 flex items-start justify-between gap-4">
      <div class="space-y-1">
        <div class="inline-flex items-center gap-2 px-2.5 py-0.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-[11px] font-semibold text-cyan-600 dark:text-cyan-400">
          <span class="w-1.5 h-1.5 rounded-full bg-cyan-500 animate-pulse"></span>
          <span>Official Technical Supplier • Muscat, Oman</span>
        </div>
        <h2 id="quote-modal-title" class="text-xl sm:text-2xl font-extrabold tracking-tight text-slate-900 dark:text-white">
          Request Equipment <span class="bg-linear-to-r from-sky-600 to-cyan-500 dark:from-cyan-400 dark:to-blue-400 bg-clip-text text-transparent">Quotation</span>
        </h2>
        <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 leading-relaxed">
          Fast pricing & technical sizing for villas, commercial gates, and installer projects across Oman.
        </p>
      </div>

      <!-- Close Button -->
      <button
        id="quote-modal-close"
        type="button"
        class="shrink-0 w-8 h-8 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white hover:bg-slate-200 dark:hover:bg-slate-700 flex items-center justify-center transition-colors cursor-pointer"
        aria-label="Close quote modal"
      >
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Modal Form Body -->
    <div class="relative max-h-[75vh] overflow-y-auto px-5 sm:px-8 py-5 custom-scrollbar">
      
      <!-- Submission Result Alert (Hidden initially) -->
      <div id="quote-form-alert" class="hidden mb-5 p-4 rounded-xl text-xs font-medium" role="alert"></div>

      <!-- Main Form -->
      <form id="quote-form" class="space-y-5 text-left" novalidate>
        <!-- Web3Forms Hidden Metadata -->
        <input type="hidden" name="access_key" value={web3FormsKey} />
        <input type="hidden" name="subject" value="New Equipment Quotation Request - GPS Muscat" />
        <input type="hidden" name="from_name" value="GPS Muscat Web Quote" />
        <!-- Spam Honeypot -->
        <input type="checkbox" name="botcheck" class="hidden" style="display: none;" tabindex="-1" autocomplete="off" />

        <!-- 1. Contact Info Section -->
        <div class="space-y-3">
          <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-1.5">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200 font-mono flex items-center gap-1.5">
              <span class="text-cyan-500">01.</span> Contact Information
            </span>
            <span class="text-[10px] text-slate-400 font-mono">* Required fields</span>
          </div>

          <!-- Pronoun / Title + First Name + Last Name -->
          <div class="grid grid-cols-1 sm:grid-cols-12 gap-3">
            <!-- Pronoun / Title -->
            <div class="sm:col-span-3">
              <label for="quote-title" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                Title / Honorific
              </label>
              <select
                id="quote-title"
                name="title"
                class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-cyan-500/20 focus:border-cyan-500 transition-colors"
              >
                <option value="Mr.">Mr. (الفاضل)</option>
                <option value="Eng.">Eng. / المهندس</option>
                <option value="Sheikh">Sheikh / الشيخ</option>
                <option value="Mrs.">Mrs. (الفاضلة)</option>
                <option value="Ms.">Ms. (الآنسة)</option>
                <option value="Dr.">Dr. (الدكتور)</option>
              </select>
            </div>

            <!-- First Name -->
            <div class="sm:col-span-5">
              <label for="quote-first-name" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                First Name <span class="text-rose-500">*</span>
              </label>
              <input
                type="text"
                id="quote-first-name"
                name="first_name"
                required
                placeholder="e.g. Mohammed"
                class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/20 focus:border-cyan-500 transition-colors"
              />
            </div>

            <!-- Last Name -->
            <div class="sm:col-span-4">
              <label for="quote-last-name" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                Last Name <span class="text-rose-500">*</span>
              </label>
              <input
                type="text"
                id="quote-last-name"
                name="last_name"
                required
                placeholder="e.g. Al Balushi"
                class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/20 focus:border-cyan-500 transition-colors"
              />
            </div>
          </div>

          <!-- Phone Number + Alternative WhatsApp -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <!-- Primary Phone -->
            <div>
              <label for="quote-phone" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                Primary Phone <span class="text-rose-500">*</span>
              </label>
              <div class="relative flex items-center">
                <span class="absolute left-3 text-xs font-mono font-semibold text-slate-400 pointer-events-none select-none">
                  🇴🇲 +968
                </span>
                <input
                  type="tel"
                  id="quote-phone"
                  name="phone"
                  required
                  placeholder="9123 4567"
                  class="w-full pl-20 pr-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/20 focus:border-cyan-500 transition-colors"
                />
              </div>
            </div>

            <!-- Optional Alternative WhatsApp -->
            <div>
              <div class="flex items-center justify-between mb-1">
                <label for="quote-whatsapp" class="text-xs font-semibold text-slate-700 dark:text-slate-300">
                  Alternative WhatsApp
                </label>
                <span class="text-[10px] text-slate-400 font-mono">Optional</span>
              </div>
              <div class="relative flex items-center">
                <span class="absolute left-3 text-xs font-mono font-semibold text-emerald-500 pointer-events-none select-none">
                  💬 +968
                </span>
                <input
                  type="tel"
                  id="quote-whatsapp"
                  name="whatsapp_number"
                  placeholder="Same as phone or alternative"
                  class="w-full pl-20 pr-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/20 focus:border-cyan-500 transition-colors"
                />
              </div>
            </div>
          </div>

          <!-- Email + Preferred Branch -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <!-- Email (Optional) -->
            <div>
              <div class="flex items-center justify-between mb-1">
                <label for="quote-email" class="text-xs font-semibold text-slate-700 dark:text-slate-300">
                  Email Address
                </label>
                <span class="text-[10px] text-slate-400 font-mono">Optional</span>
              </div>
              <input
                type="email"
                id="quote-email"
                name="email"
                placeholder="name@company.com"
                class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/20 focus:border-cyan-500 transition-colors"
              />
            </div>

            <!-- Preferred Pickup / Contact Branch -->
            <div>
              <label for="quote-branch" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                Preferred Branch in Muscat <span class="text-rose-500">*</span>
              </label>
              <select
                id="quote-branch"
                name="preferred_branch"
                required
                class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-cyan-500/20 focus:border-cyan-500 transition-colors"
              >
                <option value="Al Khoudh Branch (Showroom & Sales)">Al Khoudh Branch (Showroom & Sales - +968 9121 4949)</option>
                <option value="Ghala Branch (Technical & Parts)">Ghala Branch (Technical & Parts - +968 9744 0010)</option>
                <option value="Either / Nearest Branch">Either / Nearest Branch to Location</option>
              </select>
            </div>
          </div>
        </div>

        <!-- 2. Location & Site Address Section -->
        <div class="space-y-3 pt-2">
          <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-1.5">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200 font-mono flex items-center gap-1.5">
              <span class="text-cyan-500">02.</span> Project Location & Address in Oman
            </span>
            <span class="text-[10px] text-slate-400 font-mono">For delivery / sizing</span>
          </div>

          <!-- Region Dropdown + Client Type -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <!-- Oman Regions / Governorates Dropdown -->
            <div>
              <label for="quote-region" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                Governorate / Region (المحافظة) <span class="text-rose-500">*</span>
              </label>
              <select
                id="quote-region"
                name="governorate"
                required
                class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-cyan-500/20 focus:border-cyan-500 transition-colors"
              >
                <option value="Muscat (مسقط)">Muscat (مسقط)</option>
                <option value="Al Batinah South (جنوب الباطنة - Barka, Rustaq)">Al Batinah South (جنوب الباطنة - Barka, Rustaq)</option>
                <option value="Al Batinah North (شمال الباطنة - Sohar, Saham)">Al Batinah North (شمال الباطنة - Sohar, Saham)</option>
                <option value="Al Dakhiliyah (الداخلية - Nizwa, Samail)">Al Dakhiliyah (الداخلية - Nizwa, Samail)</option>
                <option value="Al Sharqiyah South (جنوب الشرقية - Sur)">Al Sharqiyah South (جنوب الشرقية - Sur)</option>
                <option value="Al Sharqiyah North (شمال الشرقية - Ibra)">Al Sharqiyah North (شمال الشرقية - Ibra)</option>
                <option value="Al Dhahirah (الظاهرة - Ibri)">Al Dhahirah (الظاهرة - Ibri)</option>
                <option value="Dhofar (ظفار - Salalah)">Dhofar (ظفار - Salalah)</option>
                <option value="Al Buraimi (البريمي)">Al Buraimi (البريمي)</option>
                <option value="Musandam (مسندم)">Musandam (مسندم)</option>
                <option value="Al Wusta (الوسطى)">Al Wusta (الوسطى)</option>
              </select>
            </div>

            <!-- Client / Property Category -->
            <div>
              <label for="quote-client-type" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                Property / Project Type
              </label>
              <select
                id="quote-client-type"
                name="project_type"
                class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-cyan-500/20 focus:border-cyan-500 transition-colors"
              >
                <option value="Private Villa Owner (فيلا سكنية)">Private Villa Owner (فيلا سكنية)</option>
                <option value="Contractor / Installer (مقاول / فني تركيب)">Contractor / Installer (مقاول / فني تركيب)</option>
                <option value="Commercial Facility / Office (مبنى تجاري / شركة)">Commercial Facility / Office (مبنى تجاري / شركة)</option>
                <option value="Industrial Yard / Warehouse (موقع صناعي / مستودع)">Industrial Yard / Warehouse (موقع صناعي / مستودع)</option>
                <option value="Government / Institutional (جهة حكومية / مؤسسة)">Government / Institutional (جهة حكومية / مؤسسة)</option>
              </select>
            </div>
          </div>

          <!-- 2 Text Field Address Box -->
          <div class="space-y-2.5">
            <!-- Address Line 1 -->
            <div>
              <label for="quote-address1" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
                Address Line 1 (Way / Street / Landmark) <span class="text-rose-500">*</span>
              </label>
              <input
                type="text"
                id="quote-address1"
                name="address_line1"
                required
                placeholder="e.g. Way 2315, Near Al Meera Supermarket, Al Azaiba North"
                class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/20 focus:border-cyan-500 transition-colors"
              />
            </div>

            <!-- Address Line 2 -->
            <div>
              <div class="flex items-center justify-between mb-1">
                <label for="quote-address2" class="text-xs font-semibold text-slate-700 dark:text-slate-300">
                  Address Line 2 (Villa / Building No. / Wilayat)
                </label>
                <span class="text-[10px] text-slate-400 font-mono">Optional</span>
              </div>
              <input
                type="text"
                id="quote-address2"
                name="address_line2"
                placeholder="e.g. Villa 44B, Al Seeb, Muscat"
                class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/20 focus:border-cyan-500 transition-colors"
              />
            </div>
          </div>
        </div>

        <!-- 3. Equipment & Sizing Requirements -->
        <div class="space-y-3 pt-2">
          <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-1.5">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-800 dark:text-slate-200 font-mono flex items-center gap-1.5">
              <span class="text-cyan-500">03.</span> Equipment & Sizing Requirements
            </span>
            <span class="text-[10px] text-slate-400 font-mono">Italian & Global brands</span>
          </div>

          <!-- Equipment Category Selection -->
          <div>
            <label for="quote-category" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 mb-1">
              Primary Equipment Needed <span class="text-rose-500">*</span>
            </label>
            <select
              id="quote-category"
              name="category"
              required
              class="w-full px-3 py-2 text-xs rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-cyan-500/20 focus:border-cyan-500 transition-colors"
            >
              <option value="Sliding Gate Motors (400kg – 2,000kg)">Sliding Gate Motors (400kg – 2,000kg)</option>
              <option value="Swing Gate Motors (Hydraulic & Articulated Arms)">Swing Gate Motors (Hydraulic & Articulated Arms)</option>
              <option value="Automatic Parking Boom Barriers (3m – 6m)">Automatic Parking Boom Barriers (3m – 6m)</option>
              <option value="RFID, Biometric & Access Control Systems">RFID, Biometric & Access Control Systems</option>
              <option value="Electromagnetic & Drop Bolt Heavy Duty Locks">Electromagnetic & Drop Bolt Heavy Duty Locks</option>
              <option value="Automatic Glass Door Operators & Motion Radars">Automatic Glass Door Operators & Motion Radars</option>
              <option value="Replacement Remotes, Receivers & Power Supplies">Replacement Remotes, Receivers & Power Supplies</option>
              <option value="Full Integrated Package (Gate + Barrier + Access)">Full Integrated Package (Gate + Barrier + Access)</option>
            </select>
          </div>

          <!-- Message Box -->
          <div>
            <div class="flex items-center justify-between mb-1">
              <label for="quote-message" class="text-xs font-semibold text-slate-700 dark:text-slate-300">
                Project Notes / Technical Specifications <span class="text-rose-500">*</span>
              </label>
              <span class="text-[10px] text-slate-400 font-mono">Dimensions, Gate Weight, Remotes</span>
            </div>
            <textarea
              id="quote-message"
              name="message"
              rows="3"
              required
              placeholder="e.g. Need a heavy duty 1,000kg Italian sliding gate motor kit for a villa in Al Mouj with 4 remotes and safety photocells. Gate width is 5.5 meters."
              class="w-full px-3 py-2.5 text-xs rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700 text-slate-900 dark:text-white placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500/20 focus:border-cyan-500 transition-colors resize-none leading-relaxed"
            ></textarea>
          </div>

          <!-- Technical Advice Helper Checkbox -->
          <label class="flex items-start gap-2.5 p-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200/60 dark:border-slate-800 cursor-pointer">
            <input
              type="checkbox"
              id="quote-sizing-help"
              name="need_sizing_consultation"
              checked
              class="mt-0.5 rounded text-cyan-600 focus:ring-cyan-500 dark:bg-slate-900 dark:border-slate-700"
            />
            <span class="text-[11px] text-slate-600 dark:text-slate-300 leading-snug">
              <strong>Need Technical Sizing Guidance:</strong> Please have a GPS technical representative review gate weight, wind load, or wiring cable specs for Oman weather.
            </span>
          </label>
        </div>

        <!-- Form Action Buttons -->
        <div class="pt-3 border-t border-slate-100 dark:border-slate-800 space-y-2.5">
          
          <!-- Primary: Submit via Web3Forms (Email) -->
          <button
            type="submit"
            id="quote-submit-btn"
            class="w-full flex items-center justify-center gap-2 py-3 px-5 rounded-xl bg-slate-900 hover:bg-slate-800 dark:bg-linear-to-r dark:from-sky-500 dark:to-cyan-500 dark:hover:from-sky-400 dark:hover:to-cyan-400 text-white dark:text-slate-950 font-bold text-xs sm:text-sm shadow-lg shadow-cyan-500/10 hover:shadow-cyan-500/25 transition-all duration-200 active:scale-98 cursor-pointer disabled:opacity-60 disabled:cursor-not-allowed"
          >
            <span id="quote-btn-spinner" class="hidden w-4 h-4 border-2 border-current border-t-transparent rounded-full animate-spin"></span>
            <span id="quote-btn-text">Submit Quotation Request</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </button>

          <!-- Alternative: Instant WhatsApp Quote Button -->
          <button
            type="button"
            id="quote-whatsapp-direct-btn"
            class="w-full flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl bg-emerald-500/10 hover:bg-emerald-500/20 border border-emerald-500/30 text-emerald-700 dark:text-emerald-300 font-semibold text-xs transition-all active:scale-98 cursor-pointer"
          >
            <svg class="w-4 h-4 fill-current text-emerald-600 dark:text-emerald-400" viewBox="0 0 24 24">
              <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0 0 12.04 2m.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.48 0-2.93-.4-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.196 8.196 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24m4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.25-.75-.67-1.26-1.5-1.4-1.75-.15-.25-.02-.39.11-.51.11-.11.25-.29.37-.43.13-.15.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.35-.77-1.85-.2-.49-.41-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.78 2.71 4.3 3.8.6.26 1.07.41 1.44.53.6.19 1.15.16 1.58.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.07.15-1.18-.07-.12-.23-.19-.48-.31Z" />
            </svg>
            <span>Or Send 1-Click Quote to Branch WhatsApp</span>
          </button>

          <!-- Privacy Assurance -->
          <p class="text-[11px] text-center text-slate-400 dark:text-slate-500">
            🔒 Direct quotation from official Muscat distributor. Never shared with third parties.
          </p>
        </div>

      </form>

      <!-- Success Screen State (Replaces form upon completion) -->
      <div id="quote-success-state" class="hidden text-center py-8 px-4 space-y-4">
        <div class="w-14 h-14 mx-auto rounded-full bg-emerald-500/10 text-emerald-500 flex items-center justify-center text-2xl font-bold">
          ✓
        </div>
        <div class="space-y-1.5">
          <h3 class="text-xl font-bold text-slate-900 dark:text-white">
            Quotation Request Received!
          </h3>
          <p id="quote-success-msg" class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 max-w-md mx-auto leading-relaxed">
            Thank you. Our technical sales staff has logged your project details and will prepare a pricing quote shortly.
          </p>
        </div>

        <div class="pt-3 flex flex-col sm:flex-row items-center justify-center gap-3">
          <button
            type="button"
            id="quote-success-close-btn"
            class="w-full sm:w-auto px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 dark:bg-white dark:hover:bg-slate-100 text-white dark:text-slate-950 font-semibold text-xs transition"
          >
            Close Window
          </button>
          <a
            id="quote-success-wa-btn"
            href="https://wa.me/96891214949"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-1.5 px-5 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-white font-semibold text-xs shadow-md transition"
          >
            <span>Chat on WhatsApp Now</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>

    </div>

  </div>
</div>

<script is:inline>
  // Interactive Quotation Modal & Branch Routing Controller
  (function initQuoteModal() {
    const modal = document.getElementById('quote-modal');
    const backdrop = document.getElementById('quote-modal-backdrop');
    const content = document.getElementById('quote-modal-content');
    const closeBtn = document.getElementById('quote-modal-close');
    const form = document.getElementById('quote-form');
    const submitBtn = document.getElementById('quote-submit-btn');
    const btnSpinner = document.getElementById('quote-btn-spinner');
    const btnText = document.getElementById('quote-btn-text');
    const alertBox = document.getElementById('quote-form-alert');
    const successState = document.getElementById('quote-success-state');
    const successMsg = document.getElementById('quote-success-msg');
    const successCloseBtn = document.getElementById('quote-success-close-btn');
    const successWaBtn = document.getElementById('quote-success-wa-btn');
    const directWaBtn = document.getElementById('quote-whatsapp-direct-btn');

    // Phone numbers
    const AL_KHOUDH_PHONE = '96891214949';
    const GHALA_PHONE = '96897440010';

    if (!modal) return;

    // Open Modal Function
    window.openQuoteModal = function(options = {}) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      
      // Animate In
      requestAnimationFrame(() => {
        if (content) {
          content.classList.remove('scale-95', 'opacity-0');
          content.classList.add('scale-100', 'opacity-100');
        }
      });

      // Prevent body scrolling
      document.body.style.overflow = 'hidden';

      // Pre-select category if provided
      if (options.category) {
        const catSelect = document.getElementById('quote-category');
        if (catSelect) {
          for (let i = 0; i < catSelect.options.length; i++) {
            if (catSelect.options[i].value.toLowerCase().includes(options.category.toLowerCase())) {
              catSelect.selectedIndex = i;
              break;
            }
          }
        }
      }

      // Pre-select branch if provided
      if (options.branch) {
        const branchSelect = document.getElementById('quote-branch');
        if (branchSelect) {
          for (let i = 0; i < branchSelect.options.length; i++) {
            if (branchSelect.options[i].value.toLowerCase().includes(options.branch.toLowerCase())) {
              branchSelect.selectedIndex = i;
              break;
            }
          }
        }
      }

      // Focus first input
      setTimeout(() => {
        const firstInput = document.getElementById('quote-first-name');
        if (firstInput) firstInput.focus();
      }, 100);
    };

    // Close Modal Function
    window.closeQuoteModal = function() {
      if (content) {
        content.classList.remove('scale-100', 'opacity-100');
        content.classList.add('scale-95', 'opacity-0');
      }
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        document.body.style.overflow = '';
      }, 200);
    };

    // Event Listeners for Closing
    if (closeBtn) closeBtn.addEventListener('click', window.closeQuoteModal);
    if (backdrop) backdrop.addEventListener('click', window.closeQuoteModal);
    if (successCloseBtn) successCloseBtn.addEventListener('click', window.closeQuoteModal);

    // ESC Key to close
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
        window.closeQuoteModal();
      }
    });

    // Delegate Click to all elements with [data-open-quote-modal] or "Get Quote" triggers
    document.addEventListener('click', (e) => {
      const trigger = e.target.closest('[data-open-quote-modal], .open-quote-modal-btn');
      if (trigger) {
        e.preventDefault();
        const category = trigger.getAttribute('data-quote-category') || '';
        const branch = trigger.getAttribute('data-quote-branch') || '';
        window.openQuoteModal({ category, branch });
      }
    });

    // Helper: Build Form Data Object & WhatsApp Pre-formatted Message
    function getFormData() {
      const title = document.getElementById('quote-title')?.value || 'Mr.';
      const firstName = document.getElementById('quote-first-name')?.value.trim() || '';
      const lastName = document.getElementById('quote-last-name')?.value.trim() || '';
      const phone = document.getElementById('quote-phone')?.value.trim() || '';
      const altWhatsapp = document.getElementById('quote-whatsapp')?.value.trim() || '';
      const email = document.getElementById('quote-email')?.value.trim() || '';
      const branch = document.getElementById('quote-branch')?.value || 'Al Khoudh Branch';
      const region = document.getElementById('quote-region')?.value || 'Muscat';
      const clientType = document.getElementById('quote-client-type')?.value || 'Villa Owner';
      const address1 = document.getElementById('quote-address1')?.value.trim() || '';
      const address2 = document.getElementById('quote-address2')?.value.trim() || '';
      const category = document.getElementById('quote-category')?.value || 'Gate Automation';
      const message = document.getElementById('quote-message')?.value.trim() || '';
      const sizingHelp = document.getElementById('quote-sizing-help')?.checked ? 'Yes (Requested)' : 'No';

      const targetPhone = branch.includes('Ghala') ? GHALA_PHONE : AL_KHOUDH_PHONE;

      const waText = 
`*QUOTATION REQUEST - GPS MUSCAT*
----------------------------------------
*Customer:* ${title} ${firstName} ${lastName}
*Primary Phone:* +968 ${phone}
${altWhatsapp ? `*Alt WhatsApp:* +968 ${altWhatsapp}\n` : ''}${email ? `*Email:* ${email}\n` : ''}*Governorate:* ${region}
*Address Line 1:* ${address1}
${address2 ? `*Address Line 2:* ${address2}\n` : ''}*Client Type:* ${clientType}
*Preferred Branch:* ${branch}
----------------------------------------
*Equipment Needed:*
${category}

*Project Notes:*
${message || 'Standard equipment sizing'}

*Technical Sizing Help:* ${sizingHelp}
----------------------------------------
_Sent via gpsmuscat.com official quotation form_`;

      return {
        title,
        firstName,
        lastName,
        phone,
        altWhatsapp,
        email,
        branch,
        region,
        clientType,
        address1,
        address2,
        category,
        message,
        sizingHelp,
        targetPhone,
        waText
      };
    }

    // Direct 1-Click WhatsApp Trigger
    if (directWaBtn) {
      directWaBtn.addEventListener('click', () => {
        const data = getFormData();
        
        // Basic validation before jumping to WhatsApp
        if (!data.firstName || !data.phone || !data.address1) {
          showAlert('Please fill in your Name, Phone Number, and Address Line 1 before continuing to WhatsApp.', 'error');
          return;
        }

        const encoded = encodeURIComponent(data.waText);
        const waUrl = `https://wa.me/${data.targetPhone}?text=${encoded}`;
        window.open(waUrl, '_blank');
      });
    }

    // Form Submit Handler (Web3Forms API + Local Fallback)
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const data = getFormData();

        // Validation
        if (!data.firstName || !data.lastName) {
          showAlert('Please enter your full First and Last Name.', 'error');
          return;
        }
        if (!data.phone || data.phone.length < 7) {
          showAlert('Please enter a valid Oman phone number.', 'error');
          return;
        }
        if (!data.address1) {
          showAlert('Please provide Address Line 1 (Way, Street or Landmark).', 'error');
          return;
        }
        if (!data.message) {
          showAlert('Please briefly describe your equipment or project specifications in the notes box.', 'error');
          return;
        }

        // Set Loading State
        submitBtn.disabled = true;
        btnSpinner.classList.remove('hidden');
        btnText.textContent = 'Submitting Quote...';
        clearAlert();

        const accessKey = form.querySelector('input[name="access_key"]')?.value;
        const isPlaceholderKey = !accessKey || accessKey === 'YOUR_ACCESS_KEY_HERE';

        try {
          if (!isPlaceholderKey) {
            // Live Submission to Web3Forms API
            const formData = new FormData(form);
            const response = await fetch('https://api.web3Forms.com/submit', {
              method: 'POST',
              body: formData
            });
            const result = await response.json();

            if (!response.ok || !result.success) {
              throw new Error(result.message || 'Submission failed');
            }
          } else {
            // Seamless simulated fallback for localhost development
            await new Promise(r => setTimeout(r, 700));
          }

          // Show Success State
          form.classList.add('hidden');
          successState.classList.remove('hidden');
          
          if (successMsg) {
            successMsg.textContent = `Thank you ${data.title} ${data.firstName} ${data.lastName}! We have received your quotation request for ${data.category}. Our technical team at ${data.branch} will contact you shortly on +968 ${data.phone}.`;
          }

          if (successWaBtn) {
            const encoded = encodeURIComponent(data.waText);
            successWaBtn.href = `https://wa.me/${data.targetPhone}?text=${encoded}`;
          }

        } catch (err) {
          showAlert('Could not send quotation online. Please use the "1-Click WhatsApp" button below to reach our branch directly.', 'error');
        } finally {
          submitBtn.disabled = false;
          btnSpinner.classList.add('hidden');
          btnText.textContent = 'Submit Quotation Request';
        }
      });
    }

    // Helper: Show Alert
    function showAlert(msg, type = 'error') {
      if (!alertBox) return;
      alertBox.classList.remove('hidden', 'bg-rose-500/10', 'text-rose-600', 'border-rose-500/20', 'bg-emerald-500/10', 'text-emerald-600', 'border-emerald-500/20');
      if (type === 'error') {
        alertBox.classList.add('bg-rose-500/10', 'text-rose-600', 'dark:text-rose-400', 'border', 'border-rose-500/20');
      } else {
        alertBox.classList.add('bg-emerald-500/10', 'text-emerald-600', 'dark:text-emerald-400', 'border', 'border-emerald-500/20');
      }
      alertBox.textContent = msg;
      alertBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }

    function clearAlert() {
      if (!alertBox) return;
      alertBox.classList.add('hidden');
      alertBox.textContent = '';
    }
  })();
</script>

