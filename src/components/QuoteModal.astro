          showAlert('Please enter your First and Last Name.', 'error');
          return;
        }
        if (!data.phone || data.phone.length < 7) {
          showAlert('Please enter a valid Phone Number (e.g. 9123 4567).', 'error');
          return;
        }
        if (!data.address1) {
          showAlert('Please provide your Area or Street (e.g. Al Khoudh, Seeb).', 'error');
          return;
        }

        if (submitBtn) submitBtn.disabled = true;
