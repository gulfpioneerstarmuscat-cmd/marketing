---
// Footer.astro - Master Corporate & Branch Contact Footer with Light/Dark Mode
---

<footer id="contact" class="scroll-mt-21 sm:scroll-mt-24 border-t border-slate-200 dark:border-slate-800/80 bg-white dark:bg-slate-950 pt-16 pb-12 text-slate-600 dark:text-slate-400 transition-colors duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Top Grid: About, Branches, Quick Links -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-14 border-b border-slate-200 dark:border-slate-800/80">
      
      <!-- Company Brand Summary -->
      <div class="lg:col-span-1 space-y-4">
        <!-- Dual Logo (Adapts to Light / Dark Mode) -->
        <a href="/" class="inline-block focus:outline-none">
          <img
            src="/assets/logo/GPSMUSCAT_Logo_white_500x60.svg"
            alt="GPS Muscat"
            class="h-7 w-auto object-contain hidden dark:block"
            loading="lazy"
            width="210"
            height="26"
          />
          <img
            src="/assets/logo/GPSMUSCAT_Logo_black_blue_on_white_500x60.svg"
            alt="GPS Muscat"
            class="h-7 w-auto object-contain block dark:hidden"
            loading="lazy"
            width="210"
            height="26"
          />
        </a>
        <p class="text-xs leading-relaxed text-slate-600 dark:text-slate-300">
          GPS Muscat is a dedicated technical supplier for gate automation, boom barriers, access control systems, electromagnetic locks, and security hardware across Muscat, Sultanate of Oman.
        </p>
        <div class="pt-1">
          <span class="inline-flex items-center gap-1.5 text-[11px] font-mono text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 px-2.5 py-1 rounded-md">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
            Official Supplier in Oman
          </span>
        </div>
      </div>

      <!-- Al Khoudh Branch -->
      <div class="p-5 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 space-y-3">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-bold text-slate-900 dark:text-white tracking-wide">Al Khoudh Branch</h3>
          <span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-700 dark:text-cyan-400 border border-cyan-500/20">
            Showroom & Sales
          </span>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400">
          <strong class="text-slate-800 dark:text-slate-300 font-medium">Location:</strong> Al Khoudh, Muscat, Oman
        </p>
        <p class="text-xs text-slate-600 dark:text-slate-400">
          <strong class="text-slate-800 dark:text-slate-300 font-medium">Hours:</strong> Sat – Thu: 9:00 AM – 5:00 PM <br>
          <span class="text-slate-400 dark:text-slate-500 text-[11px]">(Friday Closed)</span>
        </p>
        <div class="pt-2 flex flex-col gap-2">
          <a
            href="https://api.whatsapp.com/send?phone=96891214949"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-3 py-2 rounded-lg bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30 text-xs font-semibold transition-colors"
          >
            <span>WhatsApp +968 9121 4949</span>
          </a>
          <a
            href="tel:+96891214949"
            class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-200 dark:bg-slate-800 hover:bg-slate-300 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 text-xs font-medium transition-colors"
          >
            <span>Call +968 9121 4949</span>
          </a>
        </div>
      </div>

      <!-- Ghala Branch -->
      <div class="p-5 rounded-xl bg-slate-50 dark:bg-slate-900/60 border border-slate-200 dark:border-slate-800 space-y-3">
        <div class="flex items-center justify-between">
          <h3 class="text-sm font-bold text-slate-900 dark:text-white tracking-wide">Ghala Branch</h3>
          <span class="text-[10px] font-medium px-2 py-0.5 rounded-full bg-blue-500/10 text-blue-700 dark:text-blue-400 border border-blue-500/20">
            Technical & Parts
          </span>
        </div>
        <p class="text-xs text-slate-600 dark:text-slate-400">
          <strong class="text-slate-800 dark:text-slate-300 font-medium">Location:</strong> Ghala Industrial, Muscat, Oman
        </p>
        <p class="text-xs text-slate-600 dark:text-slate-400">
          <strong class="text-slate-800 dark:text-slate-300 font-medium">Hours:</strong> Sat – Thu: 8:00 AM – 1:00 PM & 1:00 PM – 4:00 PM <br>
          <span class="text-slate-400 dark:text-slate-500 text-[11px]">(Friday Closed)</span>
        </p>
        <div class="pt-2 flex flex-col gap-2">
          <a
            href="https://api.whatsapp.com/send?phone=96897440010"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 px-3 py-2 rounded-lg bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-700 dark:text-emerald-300 border border-emerald-500/30 text-xs font-semibold transition-colors"
          >
            <span>WhatsApp +968 9744 0010</span>
          </a>
          <a
            href="tel:+96897440010"
            class="inline-flex items-center justify-center gap-1.5 px-3 py-1.5 rounded-lg bg-slate-200 dark:bg-slate-800 hover:bg-slate-300 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 text-xs font-medium transition-colors"
          >
            <span>Call +968 9744 0010</span>
          </a>
        </div>
      </div>

      <!-- Quick Navigation & Categories -->
      <div class="space-y-3">
        <h3 class="text-xs font-bold text-cyan-600 dark:text-cyan-400 tracking-wide uppercase font-mono">
          Product Categories
        </h3>
        <ul class="space-y-2 text-xs">
          <li>
            <a href="#gate-automation" class="text-slate-600 hover:text-cyan-600 dark:text-slate-400 dark:hover:text-cyan-400 transition-colors flex items-center gap-1.5">
              <span class="text-cyan-500">›</span> Sliding & Swing Gate Motors
            </a>
          </li>
          <li>
            <a href="#products" class="text-slate-600 hover:text-cyan-600 dark:text-slate-400 dark:hover:text-cyan-400 transition-colors flex items-center gap-1.5">
              <span class="text-cyan-500">›</span> Boom Barriers (Up to 6m)
            </a>
          </li>
          <li>
            <a href="#access-control" class="text-slate-600 hover:text-cyan-600 dark:text-slate-400 dark:hover:text-cyan-400 transition-colors flex items-center gap-1.5">
              <span class="text-cyan-500">›</span> RFID & Biometric Access Control
            </a>
          </li>
          <li>
            <a href="#products" class="text-slate-600 hover:text-cyan-600 dark:text-slate-400 dark:hover:text-cyan-400 transition-colors flex items-center gap-1.5">
              <span class="text-cyan-500">›</span> EM Magnetic & Drop Bolt Locks
            </a>
          </li>
          <li>
            <a href="#products" class="text-slate-600 hover:text-cyan-600 dark:text-slate-400 dark:hover:text-cyan-400 transition-colors flex items-center gap-1.5">
              <span class="text-cyan-500">›</span> Glass Door Automation & Radars
            </a>
          </li>
          <li>
            <a href="#products" class="text-slate-600 hover:text-cyan-600 dark:text-slate-400 dark:hover:text-cyan-400 transition-colors flex items-center gap-1.5">
              <span class="text-cyan-500">›</span> Replacement Remotes & Power Supplies
            </a>
          </li>
          <li class="pt-2">
            <button
              type="button"
              data-open-quote-modal
              class="w-full py-2 px-3 rounded-lg bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-600 dark:text-cyan-400 font-semibold text-xs border border-cyan-500/20 flex items-center justify-between transition-colors cursor-pointer"
            >
              <span>Request Official Quotation</span>
              <span class="text-cyan-500 font-bold">›</span>
            </button>
          </li>
        </ul>
      </div>

    </div>

    <!-- Partner Brands Strip -->
    <div class="py-8 border-b border-slate-200 dark:border-slate-800/80 flex flex-wrap items-center justify-between gap-4">
      <span class="text-xs font-mono uppercase text-slate-500 dark:text-slate-400">Authorized Technical Brands:</span>
      <div class="flex flex-wrap items-center gap-5 sm:gap-8 opacity-75 grayscale hover:grayscale-0 transition-all duration-300">
        <img src="/assets/brands/Beninca.svg" alt="Beninca" class="h-4 sm:h-5 w-auto object-contain" loading="lazy" />
        <img src="/assets/brands/BFT.svg" alt="BFT" class="h-4 sm:h-5 w-auto object-contain" loading="lazy" />
        <img src="/assets/brands/CAME.svg" alt="CAME" class="h-4 sm:h-5 w-auto object-contain" loading="lazy" />
        <img src="/assets/brands/DEA.svg" alt="DEA" class="h-4 sm:h-5 w-auto object-contain" loading="lazy" />
        <img src="/assets/brands/ROGER.svg" alt="Roger Technology" class="h-4 sm:h-5 w-auto object-contain" loading="lazy" />
        <img src="/assets/brands/Somfy.svg" alt="Somfy" class="h-4 sm:h-5 w-auto object-contain" loading="lazy" />
        <img src="/assets/brands/HIKVISION.svg" alt="Hikvision" class="h-4 sm:h-5 w-auto object-contain" loading="lazy" />
        <img src="/assets/brands/RIB.svg" alt="RIB" class="h-4 sm:h-5 w-auto object-contain" loading="lazy" />
        <img src="/assets/brands/9.svg" alt="AALE" class="h-4 sm:h-5 w-auto object-contain" loading="lazy" />
      </div>
    </div>

    <!-- Bottom Copyright & Back to Top -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-500 dark:text-slate-400">
      <p>© {new Date().getFullYear()} GPS Muscat (Gulf Pioneer Star). All rights reserved.</p>
      
      <div class="flex items-center gap-6">
        <span>Al Khoudh & Ghala, Muscat, Oman</span>
        <a
          href="#"
          class="inline-flex items-center gap-1.5 text-cyan-600 dark:text-cyan-400 hover:text-cyan-500 font-medium transition-colors"
          aria-label="Scroll back to top"
        >
          <span>Back to Top</span>
          <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="18 15 12 9 6 15"></polyline>
          </svg>
        </a>
      </div>
    </div>

  </div>
</footer>
