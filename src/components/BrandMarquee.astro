---
// src/components/BrandMarquee.astro - Infinite Brand Partner Logo Marquee
import { partnerBrands } from '../data/brands';

// Duplicate the array to create a seamless infinite looping ribbon
const marqueeItems = [...partnerBrands, ...partnerBrands];
---

<section class="py-12 sm:py-16 border-y border-slate-200/80 dark:border-slate-800/80 bg-slate-100/40 dark:bg-slate-900/40 overflow-hidden transition-colors">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-8 text-center">
    <!-- Eyebrow Pill with Exact Scroll Margin (Target for Brands/Products) -->
    <div id="products" class="scroll-mt-21 sm:scroll-mt-24 inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-xs font-semibold text-cyan-600 dark:text-cyan-400 mb-2">
      <span id="brands" class="scroll-mt-21 sm:scroll-mt-24"></span>
      <span>Official Distribution & Direct Stock</span>
    </div>
    <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">
      Authorized European & Global <span class="bg-linear-to-r from-sky-600 to-cyan-500 dark:from-cyan-400 dark:to-blue-400 bg-clip-text text-transparent">Partner Brands</span>
    </h2>
    <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-1 max-w-xl mx-auto">
      Direct factory supply of certified gate automation, barriers, and electronic security hardware in Muscat.
    </p>
  </div>

  <!-- Marquee Outer Wrapper with Gradient Fade Edges -->
  <div class="relative w-full overflow-hidden mask-linear-fade">
    
    <!-- Left & Right Gradient Shadows for Seamless Overflow -->
    <div class="absolute left-0 inset-y-0 w-16 sm:w-28 bg-linear-to-r from-slate-50 dark:from-slate-950 to-transparent z-10 pointer-events-none"></div>
    <div class="absolute right-0 inset-y-0 w-16 sm:w-28 bg-linear-to-l from-slate-50 dark:from-slate-950 to-transparent z-10 pointer-events-none"></div>

    <!-- Scrolling Track (Infinite Marquee with Pause on Hover) -->
    <div class="flex gap-6 w-max animate-marquee hover:[animation-play-state:paused] py-2">
      {marqueeItems.map((brand) => (
        <div
          class="flex items-center gap-4 px-5 py-3.5 rounded-2xl glass-card border border-slate-200/80 dark:border-slate-800/80 hover:border-cyan-500/40 transition-all duration-300 shadow-sm hover:shadow-md shrink-0 group"
        >
          <!-- Brand Logo Graphic Container -->
          <div class="h-9 w-24 sm:w-28 flex items-center justify-center p-1 bg-white/60 dark:bg-white/10 rounded-xl border border-slate-200/60 dark:border-white/10 group-hover:scale-105 transition-transform duration-300">
            <img
              src={brand.logo}
              alt={brand.name}
              class="max-h-7 max-w-full object-contain filter dark:brightness-110"
              loading="lazy"
            />
          </div>

          <!-- Brand Details -->
          <div class="text-left">
            <div class="flex items-center gap-1.5">
              <span class="text-xs font-bold text-slate-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">
                {brand.name}
              </span>
              <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-slate-200/70 dark:bg-slate-800 text-slate-600 dark:text-slate-300">
                {brand.origin}
              </span>
            </div>
            <p class="text-[10px] text-slate-500 dark:text-slate-400 max-w-35 truncate mt-0.5">
              {brand.badge}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>

</section>

<style>
  @keyframes marquee {
    0% {
      transform: translateX(0%);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .animate-marquee {
    animation: marquee 35s linear infinite;
  }
</style>
