---
// src/components/ProductCatalog.astro - 6-Category Technical Product Showcase
import { productCategories } from '../data/products';
---

<section id="catalog" class="py-12 sm:py-16 lg:py-20 relative overflow-hidden transition-colors border-t border-slate-200/70 dark:border-slate-800/70 bg-slate-50 dark:bg-slate-950">
  
  <!-- Subtle Ambient Glow -->
  <div class="absolute top-1/3 right-0 w-125 h-125 bg-cyan-500/10 dark:bg-cyan-500/5 rounded-full blur-[140px] pointer-events-none -z-10"></div>
  <div class="absolute bottom-10 left-0 w-112.5 h-112.5 bg-blue-500/10 dark:bg-blue-600/5 rounded-full blur-[140px] pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-12">
      <div id="products" class="scroll-mt-21 sm:scroll-mt-24 inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-xs font-semibold text-cyan-600 dark:text-cyan-400 mb-3">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-500 animate-pulse"></span>
        <span>Commercial & Residential Inventory</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-slate-900 dark:text-white">
        Commercial & Residential <br class="hidden sm:inline" />
        <span class="bg-linear-to-r from-sky-600 via-cyan-500 to-blue-600 dark:from-cyan-400 dark:via-sky-300 dark:to-blue-500 bg-clip-text text-transparent">
          Gate Automation & Access Hardware
        </span>
      </h2>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 mt-3 leading-relaxed">
        Engineered for Oman's demanding environmental conditions. Sourced from authorized European and international manufacturers with full local spare parts and warranty backup.
      </p>

      <!-- Category Filter Tabs -->
      <div class="mt-8 flex flex-wrap items-center justify-center gap-2">
        <button
          type="button"
          class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all bg-slate-900 dark:bg-white text-white dark:text-slate-950 shadow-sm"
          data-filter="all"
        >
          All Categories (6)
        </button>
        <button
          type="button"
          class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all text-slate-600 dark:text-slate-300 hover:bg-slate-200/60 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800"
          data-filter="gate-automation"
        >
          Gate Motors
        </button>
        <button
          type="button"
          class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all text-slate-600 dark:text-slate-300 hover:bg-slate-200/60 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800"
          data-filter="boom-barriers"
        >
          Boom Barriers
        </button>
        <button
          type="button"
          class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all text-slate-600 dark:text-slate-300 hover:bg-slate-200/60 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800"
          data-filter="access-control"
        >
          Access Control
        </button>
        <button
          type="button"
          class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all text-slate-600 dark:text-slate-300 hover:bg-slate-200/60 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800"
          data-filter="door-locks"
        >
          Locks & Hardware
        </button>
        <button
          type="button"
          class="cat-filter-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all text-slate-600 dark:text-slate-300 hover:bg-slate-200/60 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800"
          data-filter="accessories"
        >
          Accessories
        </button>
      </div>
    </div>

    <!-- 6-Category Responsive Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 items-stretch">
      {productCategories.map((cat, idx) => (
        <article
          id={cat.id}
          class="scroll-mt-21 sm:scroll-mt-24 product-category-card flex flex-col justify-between rounded-2xl glass-card border border-slate-200/80 dark:border-slate-800/80 p-5 sm:p-6 hover:border-cyan-500/40 transition-all duration-300 hover:shadow-2xl hover:shadow-cyan-500/10 group relative"
          data-category={cat.id}
        >
          <!-- Top Category Header -->
          <div class="space-y-4">
            
            <div class="flex items-center justify-between">
              <span class="text-[11px] font-mono px-2.5 py-1 rounded-full bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20 font-semibold">
                {cat.badge}
              </span>
              <span class="text-xs font-mono text-slate-400 font-bold">
                0{idx + 1}
              </span>
            </div>

            <h3 class="text-xl font-bold text-slate-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">
              {cat.title}
            </h3>

            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              {cat.shortDesc}
            </p>

            <!-- Specification Highlights Table -->
            <div class="pt-2 border-t border-slate-200/70 dark:border-slate-800/70 grid grid-cols-2 gap-2 text-[11px]">
              {cat.specs.map(spec => (
                <div class="p-2 rounded-lg bg-slate-100/70 dark:bg-slate-900/70 border border-slate-200/50 dark:border-slate-800/60">
                  <span class="text-[10px] font-mono text-slate-400 block truncate">{spec.label}</span>
                  <span class="font-bold text-slate-800 dark:text-slate-200 block truncate mt-0.5">{spec.value}</span>
                </div>
              ))}
            </div>

            <!-- Key Features / Kit Checklist -->
            <div class="pt-3 space-y-1.5 text-xs text-slate-600 dark:text-slate-300">
              <span class="text-[10px] font-mono uppercase tracking-wider text-slate-400 block mb-1">
                Standard Kit & Compatibility:
              </span>
              {cat.highlights.slice(0, 3).map(item => (
                <div class="flex items-start gap-2 text-[11px] leading-tight">
                  <span class="text-emerald-500 font-bold shrink-0 mt-0.5">✓</span>
                  <span>{item}</span>
                </div>
              ))}
            </div>

          </div>

          <!-- Bottom CTA Action (Opens Quote Modal with pre-selected category) -->
          <div class="pt-5 mt-5 border-t border-slate-200/80 dark:border-slate-800/80">
            <button
              type="button"
              data-open-quote-modal
              data-quote-category={cat.title}
              class="w-full inline-flex items-center justify-center gap-2 py-3 px-4 rounded-xl bg-slate-900 hover:bg-slate-800 dark:bg-linear-to-r dark:from-sky-500 dark:to-cyan-500 dark:hover:from-sky-400 dark:hover:to-cyan-400 text-white dark:text-slate-950 font-bold text-xs tracking-wide shadow-md transition-all active:scale-95 cursor-pointer"
            >
              <span>Get Quotation for this Equipment</span>
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </button>
          </div>

        </article>
      ))}
    </div>

  </div>

</section>

<script is:inline>
  // Product Category Filter Script
  (function() {
    const filterBtns = document.querySelectorAll('.cat-filter-btn');
    const cards = document.querySelectorAll('.product-category-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');

        // Update active button state
        filterBtns.forEach(b => {
          b.className = "cat-filter-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all text-slate-600 dark:text-slate-300 hover:bg-slate-200/60 dark:hover:bg-slate-800 border border-slate-200 dark:border-slate-800";
        });
        btn.className = "cat-filter-btn px-4 py-2 rounded-xl text-xs font-semibold transition-all bg-slate-900 dark:bg-white text-white dark:text-slate-950 shadow-sm";

        // Show/hide cards
        cards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });
  })();
</script>
