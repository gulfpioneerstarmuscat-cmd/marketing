          href="#contact"
          aria-label="Contact Our Branches in Muscat"
          class="flex items-center justify-center w-13 h-13 sm:w-14 sm:h-14 rounded-full bg-white dark:bg-slate-900 border border-emerald-500/30 shadow-xl hover:shadow-emerald-500/30 transition-all duration-300 hover:scale-105 active:scale-95 p-3"
        >
          <img src="/assets/logo/whatsapp-color-svgrepo-com.svg" alt="Chat with GPS Muscat on WhatsApp for Gate Automation Inquiries" class="w-full h-full object-contain" />
        </a>
      </div>
    )}
    <!-- Interactive Quotation Modal -->
    <QuoteModal />

    <!-- Clean Navigation Smooth Scroll & Always Reload to Top (No #hash in URL bar) -->
    <script is:inline>
      (function initCleanNavigation() {
        // Force browser reload to always start at the top of the site (Hero)
        if ('scrollRestoration' in history) {
          history.scrollRestoration = 'manual';
        }

        // Clean any existing hash on load and ensure top position
        if (!window.location.pathname.startsWith('/admin')) {
          if (window.location.hash) {
            window.history.replaceState(null, '', window.location.pathname + window.location.search);
          }
          window.addEventListener('beforeunload', () => {
            window.scrollTo(0, 0);
          });
        }

        // Intercept internal anchor links for smooth scrolling without appending #hash to URL
        document.addEventListener('click', (e) => {
          const anchor = e.target.closest('a[href^="#"]');
          if (!anchor) return;

          const targetId = anchor.getAttribute('href');
          if (!targetId || targetId === '#') {
            e.preventDefault();
            window.scrollTo({ top: 0, behavior: 'smooth' });
            return;
          }

          try {
            const targetElement = document.querySelector(targetId);
            if (targetElement) {
              e.preventDefault();
              targetElement.scrollIntoView({ behavior: 'smooth' });

              // Close mobile drawer menu if open
              const mobileMenu = document.getElementById('mobile-menu');
              const menuToggle = document.getElementById('mobile-menu-toggle');
              const iconOpen = document.getElementById('menu-icon-open');
              const iconClose = document.getElementById('menu-icon-close');
              if (mobileMenu && !mobileMenu.classList.contains('hidden')) {
                mobileMenu.classList.add('hidden');
                menuToggle?.setAttribute('aria-expanded', 'false');
                iconOpen?.classList.remove('hidden');
                iconClose?.classList.add('hidden');
              }
            }
          } catch (err) {}
        });
      })();
    </script>

    <!-- Universal WhatsApp Route Optimizer (Direct native app launch on mobile, WhatsApp Web on desktop) -->
    <script is:inline>
      (function optimizeWhatsAppLinks() {
        const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
        
        function setupLinks() {
          document.querySelectorAll('a[href*="whatsapp.com"], a[href*="wa.me/"], a[href^="whatsapp://"]').forEach(link => {
            const href = link.getAttribute('href');
            if (href) {
              const phoneMatch = href.match(/(?:wa\.me\/|phone=)(\d+)/);
              const textMatch = href.match(/text=([^&]+)/);
              if (phoneMatch && phoneMatch[1]) {
                const phone = phoneMatch[1];
                const text = textMatch ? `&text=${textMatch[1]}` : '';
                
                if (isMobile) {
                  // Direct native WhatsApp mobile scheme to bypass intermediary download web page
                  const nativeUrl = `whatsapp://send?phone=${phone}${text}`;
                  const fallbackUrl = `https://api.whatsapp.com/send?phone=${phone}${text}`;
                  link.href = nativeUrl;
                  link.removeAttribute('target');
                  link.removeAttribute('rel');
                  
                  if (!link.dataset.waAttached) {
                    link.dataset.waAttached = 'true';
                    link.addEventListener('click', (e) => {
                      e.preventDefault();
                      const start = Date.now();
                      window.location.href = nativeUrl;
                      setTimeout(() => {
                        if (document.hasFocus() && Date.now() - start < 2000) {
                          window.location.href = fallbackUrl;
                        }
                      }, 1500);
                    });
                  }
                } else {
                  // Desktop WhatsApp Web
                  link.href = `https://web.whatsapp.com/send?phone=${phone}${text}`;
                  link.target = '_blank';
                  link.rel = 'noopener noreferrer';
                }
              }
            }
          });
        }

        setupLinks();
        if (document.readyState !== 'complete') {
          window.addEventListener('DOMContentLoaded', setupLinks);
        }
      })();
    </script>
  </body>
</html>
